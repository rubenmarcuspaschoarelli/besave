# Modelo do /srv/besave/worker.env da inst2 (mensageria, BSV-61): só o besave-envio e o alerta.
# Copie, preencha os vazios e:
#   sudo install -o besave -g besave -m 600 envio.env.example /srv/besave/worker.env
# Lido pelo systemd (EnvironmentFile): KEY=valor, sem `export`. Nunca commitar o preenchido.
# Valor com `$`, `#`, espaço ou aspa (senha do Oracle, por exemplo) vai entre ASPAS SIMPLES.
# Sem BESAVE_IMAGENS_DIR nem BESAVE_AVISOS_DIR: a inst2 não tem o espelho dos robôs; as fotos vêm
# do site, já publicadas antes de a oferta ou o aviso poderem ser enviados.

# Oracle (wallet copiada como na Fase 4 do docs/infra/VPS-INSTANCIA-1.md)
BESAVE_ORACLE_DSN=bsvdb_tp
TNS_ADMIN=/srv/besave/oracle/wallet
BESAVE_ORACLE_USER=
BESAVE_ORACLE_PASS=

# Pastas. alerta-envio.json e envio-estado.json ficam ao lado da trava.
BESAVE_LOG_DIR=/srv/besave/logs
BESAVE_ENVIO_LOCK=/srv/besave/estado/envio.lock

# Fotos pelo site (CDN do site; só https, só a base: o envio acrescenta {id}.webp ou {id}.jpg).
BESAVE_IMAGENS_URL=https://besave.com.br/img/ofertas/
BESAVE_AVISOS_URL=https://besave.com.br/img/avisos/

# Alertas (bot de alertas) e canal (bot do canal, BSV-40)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CANAL_BOT_TOKEN=
# Nome da máquina no alerta. O systemd não exporta HOSTNAME.
HOSTNAME=vps-instancia-2
