# Ciclo do worker (BSV-14) na VPS (BSV-43): uma execução por disparo do besave-ciclo.timer.
# Instalar: apps/worker/README.md, "Rodar no Linux (VPS)".
[Unit]
Description=Besave: ciclo do worker (Oracle -> S3)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=besave
Group=besave
EnvironmentFile=/srv/besave/worker.env
ExecStart=/srv/besave/bin/besave-ciclo
# Igual à tarefa do Windows: execução que passa de 20 min é encerrada.
TimeoutStartSec=20min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
