# Ciclo do worker (BSV-14) na VPS (BSV-43): uma execução por disparo do besave-ciclo.timer.
# Instalar: apps/worker/README.md, "Rodar no Linux (VPS)".
[Unit]
Description=Besave: ciclo do worker (Oracle -> S3)
Wants=network-online.target
After=network-online.target
# Encerrado pelo sistema (timeout, sinal, falha ao iniciar): o processo não avisa sozinho (BSV-47).
OnFailure=besave-alerta@%n.service

[Service]
Type=oneshot
User=besave
Group=besave
EnvironmentFile=/srv/besave/worker.env
ExecStart=/srv/besave/bin/besave-ciclo
# O ciclo normal leva ~20 s; passou de 15 min, o systemd encerra e o OnFailure avisa (BSV-47).
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
