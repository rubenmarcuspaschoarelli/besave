# Modelo do /srv/besave/worker.env da VPS (BSV-43). Copie, preencha os "..." e:
#   sudo install -o besave -g besave -m 600 worker.env.example /srv/besave/worker.env
# Lido pelo systemd (EnvironmentFile): KEY=valor, sem aspas, sem `export`. Nunca commitar o preenchido.
# Diferenças do .env do PC: sem BESAVE_ORACLE_CLIENT_DIR (o Instant Client vem do ldconfig) e com as
# pastas abaixo (no Linux não existe LOCALAPPDATA).

# Oracle (wallet da Fase 4 do docs/infra/VPS-INSTANCIA-1.md)
BESAVE_FONTE=oracle
BESAVE_ORACLE_DSN=bsvdb_tp
TNS_ADMIN=/srv/besave/oracle/wallet
BESAVE_ORACLE_USER=...
BESAVE_ORACLE_PASS=...

# Pastas. alerta.json, alerta-envio.json e envio-estado.json ficam ao lado das travas.
BESAVE_LOG_DIR=/srv/besave/logs
BESAVE_LOCK=/srv/besave/estado/worker.lock
BESAVE_ENVIO_LOCK=/srv/besave/estado/envio.lock
BESAVE_IMAGENS_DIR=/srv/besave/imagens/ofertas/img
# Imagens dos avisos (BSV-41), lidas pelo ciclo e pelo envio; copiar do PC na virada.
BESAVE_AVISOS_DIR=/srv/besave/imagens/avisos

# AWS (credenciais em ~besave/.aws/, perfil do worker)
BESAVE_BUCKET=...
BESAVE_KVS_ARN=...
BESAVE_BASE_URL=...
# Sem ela (ou false) o robots.txt vira "Disallow: /" no próximo ciclo e o site sai do Google.
BESAVE_INDEXAVEL=true
AWS_REGION=sa-east-1
AWS_PROFILE=besave-worker

# Alertas (bot de alertas) e canal (bot do canal, BSV-40)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
TELEGRAM_CANAL_BOT_TOKEN=...
# Nome da máquina no alerta. O systemd não exporta HOSTNAME: sem ela o alerta diz "desconhecido".
HOSTNAME=vps-instancia-1
