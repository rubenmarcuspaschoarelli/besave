# Modelo do /srv/besave/backup/backup.env da instância 2 (BSV-49). Copie, preencha os "..." e:
#   sudo install -o besave -g besave -m 600 backup.env.example /srv/besave/backup/backup.env
# Formato KEY=valor, sem aspas e sem `export` (o systemd e os scripts leem do mesmo jeito). Nunca commitar o preenchido.

# Usuário de backup no banco (não é o BESAVE; criado por sql/backup-dono.sql) e alias do wallet
BACKUP_DB_USER=BESAVE_BACKUP
BACKUP_DB_PASS=...
BACKUP_DB_DSN=bsvdb_high
TNS_ADMIN=/srv/besave/oracle/wallet

# Bucket da OCI (retenção 7 dias) e a credencial criada no banco (DBMS_CLOUD.CREATE_CREDENTIAL, ver README)
BACKUP_OCI_BUCKET=besave-backup
BACKUP_OCI_CREDENCIAL=BACKUP_OCI_CRED
# URL do bucket, sem barra final: https://<namespace>.objectstorage.<regiao>.oci.customer-oci.com/n/<namespace>/b/<bucket>/o
BACKUP_OCI_URI=https://...

# AWS: bucket e perfil do usuário besave-backup (~besave/.aws/credentials)
BACKUP_S3_BUCKET=besave-backup
AWS_PROFILE=besave-backup
AWS_REGION=us-east-1

# Alertas (o mesmo bot dos alertas do worker)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
HOSTNAME=vps-instancia-2
