# Tela remota :1 (Xfce sobre TigerVNC) - unidade de USUARIO.
# Instalar em ~/.config/systemd/user/ (ver tools/vps/README.md).
# Os robos dependem desta unidade (Requires= + After=): sem a tela :1 eles nao sobem.
# A autenticacao do VNC e a configurada na Fase 3 do roteiro, nunca nesta unidade.
[Unit]
Description=Besave - tela remota VNC :1
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=-/usr/bin/vncserver -kill :1
ExecStart=/usr/bin/vncserver :1 -fg -localhost yes -geometry 1600x900 -xstartup /usr/bin/startxfce4
ExecStop=/usr/bin/vncserver -kill :1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
